# ============================================================================
# 斗战三国 · 微信小游戏
# ----------------------------------------------------------------------------
# 原则：只提交「无法重建」的东西——源码、成品小游戏包、脚本、文档。
#      构建产物和备份都可重建/可还原，不入库，避免仓库被二进制撑爆。
# ============================================================================

# ---------- macOS ----------
.DS_Store

# ---------- Godot 编辑器缓存 ----------
# 由引擎自动重建，且内含本机绝对路径。
# 注意：assets 下的 *.import 文件必须提交（Godot 4 依赖它定位资源），
#      这里只排除 .godot/ 目录，不要写 *.import。
godot/.godot/

# ---------- 构建产物 ----------
# 这些由 Godot 导出生成，每次导出都是全新的二进制 blob，
# 入库会让 .git 以每版本约 17MB 的速度膨胀。
build_web/
build_web_step2/
build_brotli/

# ---------- 本地备份快照 ----------
# 每个快照都含完整的 build_web / wxgame 副本，是 210MB 的主要来源。
# 需要回溯时从本地磁盘取，不入库。
_backup/

# ---------- 验证截图 ----------
# 约 20MB 的 PNG，属于一次性验证证据，结论已写进 _notes 的 md。
_notes/徐盛验证截图/

# ---------- 微信开发者工具本地个人配置 ----------
# 官方约定不入库（窗口状态、调试开关等本机私有设置）。
wxgame/project.private.config.json
